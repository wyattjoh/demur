{
  "name": "@wyattjoh/demur",
  "version": "0.4.2",
  "type": "module",
  "description": "A proof-of-concept destructive-command guard for coding agents.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wyattjoh/demur.git"
  },
  "bugs": {
    "url": "https://github.com/wyattjoh/demur/issues"
  },
  "homepage": "https://github.com/wyattjoh/demur#readme",
  "bin": {
    "demur": "src/cli.ts",
    "demur-claude-hook": "src/adapters/claude-code.ts"
  },
  "keywords": [
    "coding-agent",
    "pi-package",
    "security"
  ],
  "files": [
    "extensions/demur/cost-tracker.ts",
    "extensions/demur/paths.ts",
    "extensions/demur/settings.ts",
    "extensions/demur/training-store.ts",
    "extensions/demur/index.ts",
    "src/adapters/claude-code.ts",
    "src/adapters/pi-worker.ts",
    "src/analyze.ts",
    "src/cli.ts",
    "src/guard.internal.ts",
    "src/guard.ts",
    "src/judge.ts",
    "src/key.ts",
    "src/policy.ts",
    "src/questions.ts",
    "src/state.ts",
    "src/training-review-model.ts",
    "src/training-review-tui.tsx",
    "src/types.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "vitest run",
    "build:pi": "bun build extensions/demur/index.ts --target=node --outfile=dist/demur-guard.js --format=esm --external @earendil-works/pi-coding-agent && bun build src/adapters/pi-worker.ts --target=bun --outfile=dist/demur-pi-worker.js --format=esm",
    "build:claude": "bun build src/adapters/claude-code.ts --target=bun --outfile=dist/demur-hook.js --format=esm",
    "build": "bun run build:pi && bun run build:claude",
    "ci": "bun run check && bun run test && bun run build",
    "eval:synthetic": "bun run eval/run.ts",
    "judge": "bun run src/cli.ts",
    "prepublishOnly": "bun run ci"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "dependencies": {
    "@effect/ai-typesafe": "4.0.0-rc.116",
    "@opentui/core": "^0.5.11",
    "@opentui/react": "^0.5.11",
    "effect": "4.0.0-rc.116",
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@effect/vitest": "4.0.0-rc.116",
    "@types/bun": "1.4.2",
    "@types/react": "^19.3.0",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  }
}

# demur environment schema.
#
# This committed file contains names and validation rules only. Put local values
# in `.env.local`, export them from your shell, or inject them with your preferred
# secret manager. Never commit a real API key.
#
# @defaultSensitive=false
# @defaultRequired=infer
# ---

# Optional TypeSafe System One API credential override. demur sends each judged
# command and its execution context to TypeSafe. When unset, demur checks the
# operating system credential store configured by `demur auth login`. Without a
# key from either source, the guard fails closed.
#
# Create a key at https://console.typesafe.ai/settings/keys.
# @type=string @sensitive @optional
TYPESAFE_API_KEY=

# # Per-attempt judgment timeout in milliseconds. Leave unset to use the default
# # in src/judge.ts.
# # @type=number(min=1) @optional
# DEMUR_TIMEOUT_MS=4000

# # Demur-specific configuration directory. When set, demur reads and writes
# # config.json directly beneath this directory instead of using XDG_CONFIG_HOME
# # or ~/.config/demur.
# # @type=string @optional
# DEMUR_CONFIG_HOME=/path/to/isolated/config

# # Demur-specific persistent state directory. When set, demur reads and writes
# # usage.json, training.jsonl, and training-reviews.jsonl directly beneath this
# # directory instead of using XDG_STATE_HOME or ~/.local/state/demur.
# # @type=string @optional
# DEMUR_STATE_HOME=/path/to/isolated/state

# # Emergency bypass. A true value allows every command without judgment.
# # Keep unset during normal use.
# # @type=boolean @optional
# DEMUR_DISABLE=1
